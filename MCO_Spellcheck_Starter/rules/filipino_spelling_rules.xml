<?xml version="1.0" encoding="UTF-8"?>
<rules lang="tl">
  <category id="FILIPINO_SPELLING_MCO2" name="Filipino Spelling Rules (OP/MMP)">

    <rule id="FIL_IKA_NUMERAL_HYPHEN" name="Ika + numeral requires hyphen">
      <pattern>
        <token regexp="yes" regexp_match="full">(?i)(ika)([0-9]{1,3})</token>
        <exception regexp="yes" regexp_match="full">(?i)ika-[0-9]{1,3}</exception>
      </pattern>
      <message>Gamitin ang gitling sa "ika-" + numeral.</message>
      <short>Ika- + numeral hyphenation</short>
      <suggestion>$1-$2</suggestion>
      <example>Tinawag siya sa <marker>ika-7</marker> na baitang.</example>
      <example correction="ika-7">Tinawag siya sa <marker>ika7</marker> na baitang.</example>
    </rule>

    <rule id="FIL_TAGA_PROPER_NOUN_HYPHEN" name="taga + proper noun requires hyphen">
      <pattern>
        <token regexp="yes" regexp_match="full">(?i)(taga)(Maynila|Cebu|Davao|Baguio)</token>
        <exception regexp="yes" regexp_match="full">(?i)taga-(Maynila|Cebu|Davao|Baguio)</exception>
      </pattern>
      <message>Kapag "taga-" + pangngalang pantangi, dapat may gitling.</message>
      <short>taga- + proper noun hyphenation</short>
      <suggestion>$1-$2</suggestion>
      <example>Siya ay <marker>taga-Maynila</marker> ngunit dito nagtatrabaho.</example>
      <example correction="taga-Maynila">Siya ay <marker>tagaMaynila</marker> ngunit dito nagtatrabaho.</example>
    </rule>

    <rule id="FIL_FULLWORD_REDUP_HYPHEN" name="Full-word reduplication needs hyphen (closed set)">
      <pattern>
        <token regexp="yes" regexp_match="full">(?i)(araw|gabi|taon)\1</token>
        <exception regexp="yes" regexp_match="full">(?i)(araw-araw|gabi-gabi|taon-taon)</exception>
      </pattern>
      <message>Sa pag-uulit ng buong salita, gamitin ang gitling.</message>
      <short>Full-word reduplication hyphenation</short>
      <suggestion>$1-$1</suggestion>
      <example>Umaaraw siya ng jogging <marker>araw-araw</marker>.</example>
      <example correction="araw-araw">Umaaraw siya ng jogging <marker>arawaraw</marker>.</example>
    </rule>

  </category>
</rules>
