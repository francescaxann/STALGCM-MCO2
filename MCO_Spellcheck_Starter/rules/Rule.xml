<?xml version="1.0" encoding="UTF-8"?>
<rules lang="tl">
  <category id="FILIPINO_SPELLING_MCO2" name="Filipino Spelling Rules (OP/MMP)">

    <rule id="FIL_IKA_NUMERAL_HYPHEN" name="Ika + numeral requires hyphen">
      <pattern>
        <token regexp="yes">ika([0-9]+)</token>
      </pattern>
      <message>Gamitin ang gitling sa "ika-" + numeral.</message>
      <suggestion><rewrite from="ika([0-9]+)" to="ika-$1"/></suggestion>
      <example correction="ika-7">Tinawag siya sa <marker>ika7</marker> na baitang.</example>
    </rule>

    <rule id="FIL_TAGA_PROPER_NOUN_HYPHEN" name="taga + proper noun requires hyphen">
      <pattern>
        <token regexp="yes">taga(Maynila|Cebu|Davao|Baguio)</token>
      </pattern>
      <message>Kapag "taga-" + pangngalang pantangi, dapat may gitling.</message>
      <suggestion><rewrite from="taga(.*)" to="taga-$1"/></suggestion>
      <example correction="taga-Maynila">Siya ay <marker>tagaMaynila</marker> ngunit dito nagtatrabaho.</example>
    </rule>

    <rule id="FIL_FULLWORD_REDUP_HYPHEN" name="Full-word reduplication needs hyphen">
      <pattern>
        <token regexp="yes">arawaraw|gabigabi|taontaon</token>
      </pattern>
      <message>Sa pag-uulit ng buong salita, gamitin ang gitling.</message>
      <suggestion><rewrite from="(araw|gabi|taon)(.*)" to="$1-$1"/></suggestion>
      <example correction="araw-araw">Nag-jogging siya <marker>arawaraw</marker>.</example>
      <example correction="gabi-gabi">Nagdarasal siya <marker>gabigabi</marker>.</example>
    </rule>

  </category>
</rules>
